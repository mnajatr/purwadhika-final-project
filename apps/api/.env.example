DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/dbname?schema=public

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# API Configuration
PORT=8000
NODE_ENV=development
API_CORS_ORIGIN=http://localhost:3000

# Midtrans Payment
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# Upstash Redis (Optional - for caching/session storage)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (Required for background jobs)
QSTASH_TOKEN=
QSTASH_URL=https://your-api-domain.com
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Job Delays (in milliseconds)
ORDER_CANCEL_DELAY_MS=900000
ORDER_CONFIRM_DELAY_MS=604800000
