{
  "name": "api",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc && tsc-alias",
    "dev": "cross-env NODE_ENV=development tsx --watch src/index.ts",
    "start": "npm run build && cross-env NODE_ENV=production node dist/src/index.js",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/client": "^6.17.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@upstash/redis": "^1.35.5",
    "bullmq": "^1.84.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "midtrans-client": "^1.4.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "winston": "^3.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/midtrans-client": "^1.4.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.9",
    "cross-env": "^7.0.3",
    "prisma": "^6.17.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^3.12.7",
    "typescript": "^5.3.3"
  }
}
